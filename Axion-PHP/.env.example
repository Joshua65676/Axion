DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
MYSQL_SSL_CA=/certs/ca.pem
CONSUMER_KEY=
CONSUMER_SECRET=
FRONTEND_URL=http://localhost:5174
API_BASE_URL=http://localhost:10000

# For Render deployment:
# - set the values above in the Render dashboard environment variables
# - keep FRONTEND_URL as your local frontend while testing locally
# - set API_BASE_URL to your deployed backend URL once the backend is live